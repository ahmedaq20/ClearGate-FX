meta {
  name: Queue Commission PDF Export
  type: http
  seq: 11
}

post {
  url: {{baseUrlApi}}/reports/export
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "type": "commissions",
    "format": "pdf",
    "params": {
      "period": "monthly",
      "date": "2026-06-01"
    }
  }
}
