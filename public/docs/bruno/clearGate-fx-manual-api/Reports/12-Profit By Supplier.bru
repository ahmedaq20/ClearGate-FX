meta {
  name: Queue Pending Excel Export
  type: http
  seq: 12
}

post {
  url: {{baseUrlApi}}/reports/export
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "type": "pending",
    "format": "excel",
    "params": {
      "date_from": "2026-06-01",
      "date_to": "2026-06-30",
      "per_page": 100
    }
  }
}
