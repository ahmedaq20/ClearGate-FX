meta {
  name: Cancelled Operations Report
  type: http
  seq: 8
}

get {
  url: {{baseUrlApi}}/reports/cancelled?date_from=2026-06-01&date_to=2026-06-30&per_page=20
  body: none
  auth: bearer
}

params:query {
  date_from: 2026-06-01
  date_to: 2026-06-30
  per_page: 20
  ~supplier_id: 1
  ~customer_id: 1
  ~box_id: 1
  ~user_id: 1
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}
