meta {
  name: Customer Report
  type: http
  seq: 5
}

get {
  url: {{baseUrlApi}}/reports/customers?date_from=2026-06-01&date_to=2026-07-30
  body: none
  auth: bearer
}

params:query {
  date_from: 2026-06-01
  date_to: 2026-07-30
  ~customer_id: 1
  ~supplier_id: 1
  ~box_id: 1
  ~user_id: 1
  ~status: completed
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}
