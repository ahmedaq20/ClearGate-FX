meta {
  name: Operations Report
  type: http
  seq: 1
}

get {
  url: {{baseUrlApi}}/reports/operations?date_from=2026-07-01&date_to=2026-07-30&group_by_status=1
  body: none
  auth: bearer
}

params:query {
  date_from: 2026-07-01
  date_to: 2026-07-30
  group_by_status: 1
  ~supplier_id: 1
  ~customer_id: 1
  ~box_id: 1
  ~user_id: 1
  ~status: completed
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}
